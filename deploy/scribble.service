[Unit]
Description=Scribble server (container)
# Works with Docker or with podman's docker shim: docker.service is wanted if it
# exists and ignored if not (e.g. podman hosts have no docker.service).
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
Restart=always
RestartSec=3
ExecStartPre=-/usr/bin/docker rm -f scribble
# SECURITY: the container runs uvicorn with --forwarded-allow-ips="*" so rate
# limiting sees the real client IP from nginx's X-Forwarded-For. That is safe
# ONLY because the port is published on 127.0.0.1 alone. Never publish it on
# 0.0.0.0 or any public address.
ExecStart=/usr/bin/docker run --rm --name scribble -p 127.0.0.1:8000:8000 -v /var/lib/scribble:/data --env-file /etc/scribble/scribble.env scribble:latest
ExecStop=/usr/bin/docker stop scribble
TimeoutStopSec=30

# No systemd sandboxing (PrivateTmp, ProtectHome, ProtectControlGroups, ...):
# it gives the service its own mount namespace, which breaks podman (network
# namespace mounts and cgroup creation become invisible/read-only, giving
# "unknown FS magic" and "No route to host" on the published port). The
# container itself is the sandbox.

[Install]
WantedBy=multi-user.target
