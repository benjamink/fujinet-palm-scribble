+Err fnapp_http_get_all(const char *devicespec, MemHandle *outH, UInt32 *outLen, UInt32 cap)
+{
+    FN_ERR rc;
+
+    if (cap < 2) {
+        return memErrInvalidParam;
+    }
+
+    rc = network_open(devicespec, OPEN_MODE_HTTP_GET, OPEN_TRANS_NONE);
+    if (rc != FN_ERR_OK) {
+        return (Err)(1000 + rc); /* distinguishable nonzero Err; callers only test zero/nonzero */
+    }
+
+    return fnapp_read_all_and_close(devicespec, outH, outLen, cap);
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticated request (GET / POST / DELETE)                        */
+/* ------------------------------------------------------------------ */
+
+/* Call order (see docs/scribble.md "FujiNet HTTP call order (Palm)"):
+ * open -> [SET_HEADERS mode, write header, BODY mode] -> [POST_SET_DATA
+ * mode, write body, BODY mode] -> read until EOF -> close. The firmware
+ * (fujinet-firmware lib/network-protocol/HTTP.cpp) only stores headers and
+ * POST data while in those channel modes; the request itself goes out on
+ * the first STATUS/READ in BODY mode, i.e. inside the read loop. So every
+ * header and the whole body must be written before the first read. */
+Err fnapp_http_request(const char *devicespec, UInt8 method, const char *authHeader,
+                       const UInt8 *body, UInt16 bodyLen,
+                       MemHandle *outH, UInt32 *outLen, UInt32 cap)
+{
+    FN_ERR rc;
+    UInt8 mode;
+
+    if (cap < 2) {
+        return memErrInvalidParam;
+    }
+
+    switch (method) {
+    case FNAPP_GET:
+        mode = authHeader ? OPEN_MODE_HTTP_GET_H : OPEN_MODE_HTTP_GET;
+        break;
+    case FNAPP_POST:
+        mode = OPEN_MODE_HTTP_POST; /* POST always accepts headers */
+        break;
+    case FNAPP_DELETE:
+        mode = authHeader ? OPEN_MODE_HTTP_DELETE_H : OPEN_MODE_HTTP_DELETE;
+        break;
+    default:
+        return memErrInvalidParam;
+    }
+
+    rc = network_open(devicespec, mode, OPEN_TRANS_NONE);
+    if (rc != FN_ERR_OK) {
+        return (Err)(1000 + rc);
+    }
+
+    if (authHeader) {
+        rc = network_http_start_add_headers(devicespec);
+        if (rc == FN_ERR_OK) {
+            /* Same as the network_http_add_header() macro, but with StrLen
+             * instead of libc strlen (this file avoids string.h). */
+            rc = network_write(devicespec, authHeader, (uint16_t)StrLen(authHeader));
+        }
+        if (rc == FN_ERR_OK) {
+            rc = network_http_end_add_headers(devicespec);
+        }
+        if (rc != FN_ERR_OK) {
+            network_close(devicespec);
+            return (Err)(1000 + rc);
+        }
+    }
+
+    if (method == FNAPP_POST && bodyLen > 0) {
+        /* network_http_post_bin: POST_SET_DATA mode, write (chunked to
+         * FujiBus frames by the bus layer), back to BODY mode. Binary-safe,
+         * unlike network_http_post which uses strlen. */
+        rc = (FN_ERR)network_http_post_bin(devicespec, body, bodyLen);
+        if (rc != FN_ERR_OK) {
+            network_close(devicespec);
+            return (Err)(1000 + rc);
+        }
+    }
+
+    return fnapp_read_all_and_close(devicespec, outH, outLen, cap);
+}
+
