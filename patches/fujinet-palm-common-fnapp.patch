  * unspecified on failure). */
 Err fnapp_http_get_all(const char *devicespec, MemHandle *outH, UInt32 *outLen, UInt32 cap);
 
+/* ------------------------------------------------------------------ */
+/* Authenticated request: like fnapp_http_get_all (same outH, outLen and cap
+ * contract, NUL at outH[*outLen], binary-safe, always closes devicespec,
+ * 1000 + FN_ERR on a library failure), plus a method, an optional header
+ * and, for POST, a binary body.
+ *
+ *   method       FNAPP_GET, FNAPP_POST or FNAPP_DELETE.
+ *   authHeader   one full header line WITHOUT a trailing CR/LF, e.g.
+ *                "Authorization: Bearer abc", or NULL for none. The colon
+ *                MUST be followed by exactly one space: the firmware takes
+ *                the value as everything from two bytes after the colon.
+ *                GET/DELETE open with the _H modes only when this is set.
+ *   body/bodyLen POST body (any bytes, 0x00 included; up to 65535).
+ *                Ignored for GET/DELETE.
+ *
+ * A non-2xx reply (the server's HTTP 401 "err auth\n") is NOT an error
+ * here: its body is returned like any other and the caller parses it.
+ * See docs/scribble.md "FujiNet HTTP call order (Palm)". */
+#define FNAPP_GET    0
+#define FNAPP_POST   1
+#define FNAPP_DELETE 2
+
+Err fnapp_http_request(const char *devicespec, UInt8 method, const char *authHeader,
+                       const UInt8 *body, UInt16 bodyLen,
+                       MemHandle *outH, UInt32 *outLen, UInt32 cap);
+
 /* ------------------------------------------------------------------ */
 /* Decimal-string parsing -- this target has NO floating point, so numeric
  * JSON fields that look like "-48.2919" must be split by hand. */
